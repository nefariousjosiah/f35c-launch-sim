# Text files: normalise line endings.
* text=auto
*.cpp text eol=crlf
*.h text eol=crlf
*.cs text eol=crlf
*.ini text eol=crlf
*.uproject text eol=crlf

# Unreal binary assets go through Git LFS. Only content we have the right to
# share is ever committed (our own work, CC0, attributed CC-BY); see ASSETS.md.
*.uasset filter=lfs diff=lfs merge=lfs -text
*.umap filter=lfs diff=lfs merge=lfs -text
*.fbx filter=lfs diff=lfs merge=lfs -text
*.png filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text
*.hdr filter=lfs diff=lfs merge=lfs -text
*.exr filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text
*.gif filter=lfs diff=lfs merge=lfs -text
*.mp4 filter=lfs diff=lfs merge=lfs -text

# README media is small and viewed often: keep it in plain git so it renders on
# GitHub without spending the LFS bandwidth quota.
Docs/Media/** -filter -diff -merge -text
